<!DOCTYPE html>
<html>
  <head><title>Snipcart Templates</title></head>
  <body>
    <div id="snipcart-templates">
      <cart-summary-item item="item">
        <li class="snipcart-cart-summary__item">
          <div class="snipcart-cart-summary__item-image">
            <img v-if="item.image" :src="item.image" :alt="item.name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" />
          </div>
          <div class="snipcart-cart-summary__item-details">
            <span class="snipcart-cart-summary__item-name">{{ item.name }}</span>
            <span class="snipcart-cart-summary__item-qty">x{{ item.quantity }}</span>
          </div>
          <div class="snipcart-cart-summary__item-price">
            {{ item.totalPriceWithoutModificationsDisplay }}
          </div>
        </li>
      </cart-summary-item>
    </div>
  </body>
</html>
